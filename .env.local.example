# Supabase Configuration (only needed for the disabled Supabase video library)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=videos

# Pexels API (free -- get instant key at https://www.pexels.com/api/)
PEXELS_API_KEY=your-pexels-api-key

# Vercel Blob (serverless render pipeline). Create a free Blob store in
# the Vercel dashboard (Storage → Blob → Connect to Project) and the
# token is injected automatically in Production/Preview. Pull for dev:
#   vercel env pull
# Without the token, renders fall back to local disk in `next dev` and
# the in-browser WebCodecs pipeline in production.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_…

# Optional: protect /api/cron/cleanup from manual invocation
# CRON_SECRET=generate-a-random-string
