# Supabase Configuration (only needed for the disabled Supabase video library)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=videos

# Pexels API (free -- get instant key at https://www.pexels.com/api/)
PEXELS_API_KEY=your-pexels-api-key

# Cloud render service (optional -- HF Space, see render-service/README.md)
# When set, generation renders server-side first and falls back to the
# browser pipeline automatically if the service is unreachable.
# NEXT_PUBLIC_RENDER_API_URL=https://your-name-midhkar-render.hf.space
